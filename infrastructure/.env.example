# Copy to infrastructure/.env and fill in. Scripts source this file before plan/apply.
# Do not commit .env.

# Target environment root under environments/ (staging | production)
TF_ENV=staging

# AWS credentials — prefer a named profile over long-lived keys
AWS_REGION=us-east-1
AWS_PROFILE=pack-draft-staging

# Optional: override profile with static keys (local only)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# Terraform variables (TF_VAR_* maps to input variables)
TF_VAR_project_name=pack-draft
TF_VAR_environment=staging
